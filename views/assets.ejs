<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fixed Asset Register</h2>
    <div class="dropdown">
        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Sort Assets By
        </button>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/assets?sort=cost">Highest Original Cost</a></li>
            <li><a class="dropdown-item" href="/assets?sort=nbv">Highest Net Book Value</a></li>
            <li><a class="dropdown-item" href="/assets?sort=date">Newest Acquisition</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/assets">Clear Sort</a></li>
        </ul>
    </div>
</div>

<table class="table table-striped table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Asset No</th>
            <th>Cost Center</th>
            <th>Acquisition Date</th>
            <th>Cost</th>
            <th>Acc. Depreciation</th>
            <th>Net Book Value</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% assets.forEach(asset => { 
            let nbv = asset.cost - asset.accDepreciation; 
        %>
            <tr>
                <td><strong><%= asset.assetNo %></strong></td>
                <td><%= asset.costCenter %></td>
                <td><%= asset.acquisitionDate %></td>
                <td><%= formatCurrency(asset.cost) %></td>
                <td><%= formatCurrency(asset.accDepreciation) %></td>
                <td class="fw-bold text-success"><%= formatCurrency(nbv) %></td>
                <td>
                    <a href="/assets/<%= asset.id %>" class="btn btn-sm btn-info">View</a>
                    <a href="/assets/<%= asset.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/assets/<%= asset.id %>/delete" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this asset?')">Delete</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include('partials/footer') %>